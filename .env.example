# Copy to .env.local and fill in real values. Never commit .env.local.
# Placeholder values only. Do not put live keys in this file.

# --- App ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override for invite and password-reset links
APP_URL_FOR_INVITES=
LOG_LEVEL=debug

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Defaults to the project storage URL.
SUPABASE_STORAGE_URL=
SUPABASE_PRIVATE_BUCKET=ivr-private
IVR_PRIVATE_BUCKET=ivr-private
# Shared secret for the Supabase Send Email hook
SUPABASE_EMAIL_HOOK_SECRET=your-email-hook-secret

# --- Auth behavior ---
# AUTH_MIDDLEWARE_REFRESH_SKIP=0
# AUTH_MIDDLEWARE_REFRESH_MARGIN_SEC=180
# AUTH_MIDDLEWARE_TIMEOUT_MS=4000
# NEXT_PUBLIC_AUTH_BROWSER_AUTO_REFRESH=

# --- Stripe ---
# Use test keys locally. STRIPE_API_* is only for the local mock in scripts/local-integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_API_HOST=127.0.0.1
# STRIPE_API_PORT=12112
# STRIPE_API_PROTOCOL=http
# APP_WEBHOOK_URL=http://127.0.0.1:3010/api/stripe/webhook

# Invoice wire text. If unset, the app uses the built-in remittance copy.
PORTAL_WIRE_INSTRUCTIONS=
INVOICE_WIRE_INSTRUCTIONS=

# --- Email (Microsoft Graph) ---
# EMAIL_MODE: graph | disabled. Unset means disabled. graph sends mail.
EMAIL_MODE=disabled
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=360 Medical
EMAIL_REPLY_TO=support@example.com
EMAIL_IVR_FROM_ADDRESS=
EMAIL_IVR_FROM_NAME=
EMAIL_ORDER_FROM_ADDRESS=
EMAIL_ORDER_FROM_NAME=
EMAIL_TEST_TO=you@example.com
# Last-resort recipient for the admin email-test route. Not an SMTP server.
SMTP_USER=
ORDER_NOTIFY_TO=orders@example.com
ORDER_NOTIFY_CC=
IVR_STAFF_NOTIFY_TO=ivr-staff@example.com
IVR_TEAM_NOTIFY_TO=ivr-team@example.com
IVR_TEAM_EMAILS=
SUPPORT_REQUEST_EMAIL=support@example.com

# --- FedEx ---
# Unset FEDEX_ENV uses the FedEx sandbox. Set production only for live labels.
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=your-fedex-client-id
FEDEX_CLIENT_SECRET=your-fedex-client-secret
FEDEX_ACCOUNT_NUMBER=your-account-number
FEDEX_LABEL_STOCK_TYPE=PAPER_4X6
FEDEX_SHIP_FROM_COMPANY=360 Medical
FEDEX_SHIP_FROM_PHONE=0000000000
FEDEX_SHIP_FROM_LINE1=123 Example St
FEDEX_SHIP_FROM_LINE2=
FEDEX_SHIP_FROM_CITY=McAllen
FEDEX_SHIP_FROM_STATE=TX
FEDEX_SHIP_FROM_POSTAL=78501
FEDEX_SHIP_FROM_COUNTRY=US
# FEDEX_DEBUG=1

# --- OpenAI ---
# Intelligence extraction, transcription, and product research. The app degrades when this is unset.
OPENAI_API_KEY=sk-replace-me
# OPENAI_NOTE_CAPTURE_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_LOG_UPDATE_MAP_MODEL=
# OPENAI_PREP_PLAN_FIELD_MODEL=
# OPENAI_DEBRIEF_STRATEGY_MODEL=
# OPENAI_DEBRIEF_EMAIL_DRAFT_MODEL=
# OPENAI_PROVIDER_AI_SUMMARY_MODEL=

# --- Universal Facts / intelligence flags ---
# Leave unset unless you are turning on a specific path. "1" enables.
# UNIVERSAL_SURGICAL_FACTS_PERSIST=1
# UNIVERSAL_FACTS_READ_MODEL=1
# USE_GPT_UNIVERSAL_FACT_EXTRACTOR=1
# UNIVERSAL_EXTRACTOR_SHADOW_MODE=1
# UNIVERSAL_SURGICAL_FACTS_PANEL=1
# NEXT_PUBLIC_UNIVERSAL_SURGICAL_FACTS_PANEL=1
# UF_AUTHORITY_REVIEW=1
# UF_EXTRACTION_REVIEW_PRIMARY=1
# DIP_REVIEW_SHADOW=1
# ASSERTION_AWARE_INTELLIGENCE=1
# OBSERVATION_AI_FIRST_EXTRACTION=1
# OBSERVATION_PILOT_HIDE_BULK_CAPTURE=1
# NEXT_PUBLIC_OBSERVATION_PILOT_HIDE_BULK_CAPTURE=1
# OBSERVATION_FACT_LLM_FALLBACK=0
# AI_NOTE_CAPTURE_MOCK_ONLY=1
# UNIVERSAL_EXTRACTOR_TEST_HARNESS=1
# COACHING_GUIDANCE_INPUTS_COMPARE=1

# --- Document conversion ---
CLOUDCONVERT_API_KEY=
CONVERTAPI_SECRET=
LIBREOFFICE_PATH=

# --- Partner integrations ---
INTEGRATION_CREDENTIALS_KEY=
INTEGRATION_WORKER_SECRET=
INTEGRATION_OUTBOUND_ENABLED=false
# Used only by scripts/local-integration against the local lab, never production.
# NIMBLE_STAGING_KEY=
# https origin those scripts call. Leave unset for normal app development.
# NIMBLE_STAGING_CALLBACK_URL=

# --- Other ---
# accounts.id used when product files have no account of their own.
PRODUCT_FILES_ACCOUNT_ID=
INTERNAL_TEAM_ACCOUNT_ID=
# accounts.id that owns the internal dropship vendor directory shown on fulfillments.
# PRODUCT_FILES_ACCOUNT_ID is a legacy fallback for that directory only.
INTERNAL_VENDOR_ACCOUNT_ID=
SURGICAL_CASE_NOTIFICATIONS_CRON_SECRET=
# SURGICAL_CASE_NOTIFICATIONS_EMAIL=true

# --- Playwright / local e2e (optional) ---
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_TOTP_SECRET=
E2E_ENGAGEMENT_ID=
E2E_PROVIDER_ID=
E2E_ACCOUNT_ID=
# E2E_MAGICLINK=
# AUDIT_STRICT=1
# PLAYWRIGHT_PORT=3000
