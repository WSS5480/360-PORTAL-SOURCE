{
  "name": "portal-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H localhost -p 3000",
    "dev:local-integration": "node scripts/local-integration/run.mjs",
    "dev:turbo": "next dev --turbopack -H localhost -p 3000",
    "dev:webpack": "next dev --webpack -H localhost -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest",
    "test:observation-intelligence": "vitest run src/lib/surgical-sales/observationIntelligence/testSuite/observationIntelligenceTestSuite.test.ts",
    "test:observation-torture": "vitest run src/lib/surgical-sales/observationIntelligence/testSuite/torture/observationIntelligenceTortureSuite.test.ts && npx tsx scripts/run-observation-torture.mts",
    "test:observation-validation": "npm run test:observation-intelligence && npm run test:observation-torture",
    "test:intelligence-regression": "vitest run src/lib/surgical-sales/intelligenceRegression/intelligenceRegressionRunner.test.ts src/lib/surgical-sales/intelligenceRegression/fullPipelineIntelligenceRegression.test.ts src/lib/surgical-sales/intelligenceRegression/universalIntelligenceMatrix.test.ts",
    "test:watch": "vitest --watch",
    "test:debrief-parity": "vitest run src/lib/surgical-sales/universalExtractor/compareDebriefExtractionParity.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:case-dictation-intelligence": "playwright test tests/e2e/surgical-case-dictation-intelligence.spec.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.5",
    "@react-pdf/renderer": "^4.3.2",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@zxing/browser": "^0.1.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "docx": "^9.5.1",
    "libreoffice-convert": "^1.7.0",
    "next": "^16.1.6",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "stripe": "^20.3.0",
    "topojson-client": "^3.1.0",
    "unpdf": "^1.6.0",
    "us-atlas": "^3.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.12.7",
    "otplib": "^13.4.1",
    "pg": "^8.23.1",
    "playwright": "^1.58.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
